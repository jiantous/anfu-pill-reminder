# 构建产物
build/
app/build/
.gradle/
local.properties

# 签名相关：绝对不要提交
*.jks
*.keystore
keystore.properties

# IDE
.idea/
*.iml
.DS_Store

# 从手机拉下来的用药数据备份，属于个人健康信息
_backups/

# 设计工具生成的预览图（重新跑脚本即可再生成）
design/*_compare.png
design/med_icons_preview.png
design/med_icons_small.png

# Python 缓存
__pycache__/
*.pyc

# 准备上传到 Release 的产物。APK 不进仓库——几十 MB 的二进制会让
# clone 变慢，且每次构建都不同，Release 附件才是它该待的地方。
release-v*/

# adb 截图 / uiautomator dump，纯调试用，跟改动无关
_shots/
